package com.gabriel.tvos

import android.annotation.SuppressLint
import android.app.Activity
import android.content.Context
import android.content.Intent
import android.content.pm.ResolveInfo
import android.graphics.Bitmap
import android.graphics.Canvas
import android.graphics.Color
import android.graphics.drawable.Drawable
import android.os.Bundle
import android.util.Base64
import android.view.View
import android.webkit.JavascriptInterface
import android.webkit.WebView
import android.webkit.WebViewClient
import org.json.JSONArray
import org.json.JSONObject
import java.io.ByteArrayOutputStream

class MainActivity : Activity() {

    private lateinit var webView: WebView

    @SuppressLint("SetJavaScriptEnabled")
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        webView = WebView(this).apply {
            setBackgroundColor(Color.parseColor("#0b0f19"))
            isFocusable = true
            isFocusableInTouchMode = true
            isVerticalScrollBarEnabled = false
            isHorizontalScrollBarEnabled = false
            overScrollMode = View.OVER_SCROLL_NEVER
            setOnLongClickListener { true }
            isHapticFeedbackEnabled = false
            settings.javaScriptEnabled = true
            settings.domStorageEnabled = true
            settings.allowFileAccess = true
            webViewClient = WebViewClient()
            addJavascriptInterface(Bridge(), "Android")
        }
        setContentView(webView)
        webView.loadUrl("file:///android_asset/index.html")
        webView.requestFocus()
    }

    override fun onResume() {
        super.onResume()
        hideSystemUi()
        webView.requestFocus()
        webView.evaluateJavascript("window.refreshApps&&window.refreshApps()", null)
    }

    override fun onNewIntent(intent: Intent?) {
        super.onNewIntent(intent)
        // กดปุ่ม Home ซ้ำ -> กลับหน้าหลัก
        webView.evaluateJavascript("window.handleHome&&window.handleHome()", null)
    }

    override fun onWindowFocusChanged(hasFocus: Boolean) {
        super.onWindowFocusChanged(hasFocus)
        if (hasFocus) hideSystemUi()
    }

    @Suppress("DEPRECATION", "OVERRIDE_DEPRECATION")
    override fun onBackPressed() {
        // เป็น Launcher: ไม่ออกจากแอป ให้ JS ปิด drawer/เมนูเท่านั้น
        webView.evaluateJavascript("window.handleBack&&window.handleBack()", null)
    }

    @Suppress("DEPRECATION")
    private fun hideSystemUi() {
        window.decorView.systemUiVisibility = (View.SYSTEM_UI_FLAG_LAYOUT_STABLE
                or View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN
                or View.SYSTEM_UI_FLAG_LAYOUT_HIDE_NAVIGATION
                or View.SYSTEM_UI_FLAG_FULLSCREEN
                or View.SYSTEM_UI_FLAG_HIDE_NAVIGATION
                or View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY)
    }

    private fun iconToBase64(d: Drawable, size: Int = 96): String {
        val bmp = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
        val canvas = Canvas(bmp)
        d.setBounds(0, 0, size, size)
        d.draw(canvas)
        val out = ByteArrayOutputStream()
        bmp.compress(Bitmap.CompressFormat.PNG, 100, out)
        return Base64.encodeToString(out.toByteArray(), Base64.NO_WRAP)
    }

    inner class Bridge {

        private val prefs get() = getSharedPreferences("gabrielos", Context.MODE_PRIVATE)

        @Suppress("DEPRECATION")
        @JavascriptInterface
        fun getApps(): String {
            val pm = packageManager
            val found = LinkedHashMap<String, ResolveInfo>()
            for (cat in listOf(Intent.CATEGORY_LEANBACK_LAUNCHER, Intent.CATEGORY_LAUNCHER)) {
                val i = Intent(Intent.ACTION_MAIN).addCategory(cat)
                for (ri in pm.queryIntentActivities(i, 0)) {
                    val p = ri.activityInfo.packageName
                    if (p != packageName && !found.containsKey(p)) found[p] = ri
                }
            }
            val list = found.values
                .map { Triple(it.activityInfo.packageName, it.loadLabel(pm).toString(), it) }
                .sortedBy { it.second.lowercase() }

            val arr = JSONArray()
            for ((pkg, label, ri) in list) {
                val o = JSONObject()
                o.put("pkg", pkg)
                o.put("name", label)
                o.put("icon", try { iconToBase64(ri.loadIcon(pm)) } catch (e: Exception) { "" })
                arr.put(o)
            }
            return arr.toString()
        }

        @JavascriptInterface
        fun getPins(): String = prefs.getString("pins", "[]") ?: "[]"

        @JavascriptInterface
        fun savePins(json: String) {
            prefs.edit().putString("pins", json).apply()
        }

        /** รับ package เดียว หรือหลายตัวคั่นด้วย comma (ลองตามลำดับ) */
        @JavascriptInterface
        fun launch(csv: String): Boolean {
            for (p in csv.split(",")) {
                val pkg = p.trim()
                if (pkg.isEmpty()) continue
                val intent = packageManager.getLeanbackLaunchIntentForPackage(pkg)
                    ?: packageManager.getLaunchIntentForPackage(pkg)
                if (intent != null) {
                    intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_RESET_TASK_IF_NEEDED)
                    runOnUiThread {
                        try { startActivity(intent) } catch (_: Exception) {}
                    }
                    return true
                }
            }
            return false
        }
    }
}
